# NQ Adaptive Scalper Configuration
# Copy to .env and fill in your values

# Feed connection
NQ_SCALPER_FEED_URL=ws://localhost:8080/feed
NQ_SCALPER_FEED_TYPE=sim  # rithmic, tradovate, sim
NQ_SCALPER_API_KEY=your_api_key_here
NQ_SCALPER_API_SECRET=your_api_secret_here

# Account settings (TopstepX)
NQ_SCALPER_ACCOUNT_SIZE=50k  # 50k, 100k, 150k
NQ_SCALPER_MAX_CONTRACTS=2
NQ_SCALPER_DAILY_LOSS_LIMIT=800
NQ_SCALPER_MAX_DRAWDOWN=1800

# Risk
NQ_SCALPER_MAX_RISK_PER_TRADE=200
NQ_SCALPER_MIN_RR_RATIO=1.5
NQ_SCALPER_MIN_CONFIDENCE=0.55

# Session filters
NQ_SCALPER_TRADE_ASIAN=false
NQ_SCALPER_TRADE_LONDON=true
NQ_SCALPER_TRADE_NY_OPEN=true
NQ_SCALPER_TRADE_NY_AFTERNOON=true
NQ_SCALPER_TRADE_NY_CLOSE=false

# Logging
NQ_SCALPER_LOG_LEVEL=INFO
