# NQ Adaptive Scalper Configuration
# Copy to .env and fill in your values

# ========================================
# TopstepX / ProjectX API Credentials
# ========================================
# Get API access at: https://dashboard.projectx.com
# Go to Subscriptions > ProjectX API Access ($29/mo, use code "topstep" for 50% off)
NQ_SCALPER_USERNAME=your_topstepx_username
NQ_SCALPER_API_KEY=your_api_key_here

# Feed type: topstepx (real data), sim (simulated)
NQ_SCALPER_FEED_TYPE=topstepx

# ========================================
# Account Settings (TopstepX)
# ========================================
NQ_SCALPER_ACCOUNT_SIZE=50k  # 50k, 100k, 150k
NQ_SCALPER_MAX_CONTRACTS=2
NQ_SCALPER_DAILY_LOSS_LIMIT=800
NQ_SCALPER_MAX_DRAWDOWN=1800

# ========================================
# Risk Management
# ========================================
NQ_SCALPER_MAX_RISK_PER_TRADE=200
NQ_SCALPER_MIN_RR_RATIO=1.5
NQ_SCALPER_MIN_CONFIDENCE=0.55

# ========================================
# Session Filters (Eastern Time)
# ========================================
NQ_SCALPER_TRADE_ASIAN=false       # 18:00-02:00 ET (thin, skip)
NQ_SCALPER_TRADE_LONDON=true       # 02:00-08:00 ET
NQ_SCALPER_TRADE_NY_OPEN=true      # 08:00-12:00 ET (best liquidity)
NQ_SCALPER_TRADE_NY_AFTERNOON=true # 12:00-16:00 ET
NQ_SCALPER_TRADE_NY_CLOSE=false    # 16:00-17:00 ET (thin, skip)

# ========================================
# Logging
# ========================================
NQ_SCALPER_LOG_LEVEL=INFO
